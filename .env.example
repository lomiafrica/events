## Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=''
NEXT_PUBLIC_SANITY_DATASET='production'
# Editor token with write access on the production dataset (catalog sync write-back).
SANITY_WRITE_TOKEN=''
# Shared by /api/revalidate and /api/sanity/lomi-sync. Set the same value on the Sanity webhook.
SANITY_WEBHOOK_SECRET=''

# Supabase
NEXT_PUBLIC_SUPABASE_URL=''
NEXT_PUBLIC_SUPABASE_ANON_KEY=''
SUPABASE_SERVICE_ROLE_KEY=''

# lomi.
LOMI_WEBHOOK_SECRET=''
# Merchant secret key for POST /products and checkout (also set on the Supabase functions).
LOMI_SECRET_KEY=''
# Optional. Defaults to https://api.lomi.africa
LOMI_API_URL='https://api.lomi.africa'

#
# Sanity webhook (dashboard → API → Webhooks)
# URL: https://djaoulient.com/api/sanity/lomi-sync
# Dataset: production
# Trigger: Create + Update
# Filter (avoids loops when IDs are written back):
#
# _type in ["product", "event"] && !(_id in path("drafts.**")) && (
#   delta::operation() == "create" ||
#   delta::changedAny(
#     name,
#     basePrice,
#     description,
#     images,
#     title,
#     ticketsAvailable,
#     ticketTypes[].name,
#     ticketTypes[].price,
#     ticketTypes[].active,
#     ticketTypes[].description,
#     bundles[].name,
#     bundles[].price,
#     bundles[].active,
#     bundles[].description
#   )
# )
#
# Projection (the route re-fetches the document; this is enough):
# { _id, _type }
#
# HTTP secret: same as SANITY_WEBHOOK_SECRET
#
